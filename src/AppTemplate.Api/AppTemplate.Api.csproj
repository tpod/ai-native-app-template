<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <InternalsVisibleTo Include="AppTemplate.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppTemplate.Domain\AppTemplate.Domain.csproj" />
    <ProjectReference Include="..\AppTemplate.ServiceDefaults\AppTemplate.ServiceDefaults.csproj" />
  </ItemGroup>

  <!-- Publish-only: a normal build or test run never touches npm. -->
  <Target Name="BuildWeb" BeforeTargets="ComputeFilesToPublish">
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)/../web" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/../web" />
    <!-- wwwroot was globbed before the build produced it, so add the fresh output to the publish set here. -->
    <ItemGroup>
      <_WebBuildOutput Include="$(MSBuildProjectDirectory)/wwwroot/**" />
      <ResolvedFileToPublish Include="@(_WebBuildOutput)" RelativePath="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
