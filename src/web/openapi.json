          }
        },
        "required": [
          "projectId"
        ],
        "type": "object"
      },
      "Change": {
        "properties": {
          "after": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonNode"
              }
            ]
          },
          "before": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonNode"
              }
            ]
          },
          "entity": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "op": {
            "type": "string"
          }
        },
        "required": [
          "entity",
