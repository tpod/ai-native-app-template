            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "code": {
            "description": "Stable machine-readable error code, for example note.locked.",
            "type": "string"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "details": {
            "description": "Error-specific structured data; may be null."
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ]
          },
          "suggestion": {
            "description": "What the caller can do to fix the problem.",
            "type": "string"
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "traceId": {
            "description": "Correlates the response with server logs and traces.",
            "type": "string"
          },
          "type": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "type": "object"
      },
