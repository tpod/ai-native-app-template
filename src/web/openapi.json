          "name",
          "status",
          "version",
          "tasks"
        ],
        "type": "object"
      },
      "ProjectStatus": {
        "enum": [
          "active",
          "archived"
        ]
      },
      "ProjectSummaryDto": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "openTaskCount": {
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
