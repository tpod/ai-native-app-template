  "paths": {
    "/api/actions/add_task": {
      "post": {
        "description": "Add an open task to an active project. Possible error codes: project.archived, project.not_found, validation.failed. Requires previewToken from preview_add_task. Show the user the preview summary and changes and get their confirmation before calling this tool.",
        "operationId": "add_task",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/AddTaskInput"
                  },
                  {
                    "properties": {
                      "previewToken": {
                        "description": "Token from the matching preview operation; authorizes this execute.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "previewToken"
                    ],
                    "type": "object"
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecuteResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Possible codes: preview.token_invalid, request.malformed."
          },
          "404": {
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Possible codes: project.not_found."
          },
          "409": {
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Possible codes: preview.already_executed, preview.expired, preview.stale, preview.token_mismatch, project.archived."
          },
          "422": {
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Possible codes: validation.failed."
          },
          "500": {
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Possible codes: internal.unexpected."
          }
        },
        "tags": [
          "AppTemplate.Api"
        ]
      }
    },
